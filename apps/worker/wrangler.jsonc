{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sovereign-final",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../web/dist" },
  "observability": { "enabled": true, "logs": { "invocation_logs": true }, "traces": { "head_sampling_rate": 0.05 } },
  "d1_databases": [{"binding":"DB","database_name":"REPLACE_WITH_PRODUCTION_DB","database_id":"REPLACE_WITH_PRODUCTION_DB_ID"}],
  "durable_objects": {"bindings":[{"name":"THREADS","class_name":"ThreadCoordinator"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["ThreadCoordinator"]}],
  "ai": {"binding":"AI"},
  "vars": {
    "AI_PROVIDER":"cloudflare-gateway",
    "AI_MODEL":"@cf/zai-org/glm-4.7-flash",
    "AI_GATEWAY_ID":"sovereign-ai-gateway"
  }
}
